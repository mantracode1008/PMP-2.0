{
  "name": "pmp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Project Management Portal (PMP) - Enterprise Modular Monolith (Phase 1)",
  "scripts": {
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "cd backend && npm run test:e2e",
    "test": "npm run test:backend",
    "db:push": "cd backend && npm run prisma:push",
    "db:seed": "cd backend && npm run prisma:seed"
  },
  "keywords": [
    "pmp",
    "project-management",
    "nestjs",
    "nextjs",
    "prisma",
    "postgresql"
  ],
  "author": "PMP Core Team",
  "license": "UNLICENSED"
}
